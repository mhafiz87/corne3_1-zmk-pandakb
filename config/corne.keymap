#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "zmk-helpers/key-labels/42.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        thml: timeless_homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "THML";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        thmr: timeless_homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "THMR";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        gtl0: go_to_layer_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "GTL0";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&to 0>;

            tapping-term-ms = <200>;
        };

        gtl1: go_to_layer_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "GTL1";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&to 1>;

            tapping-term-ms = <200>;
        };

        gtl4: go_to_layer_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "GTL4";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&to 4>;

            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        end_key {
            bindings = <&kp END>;
            key-positions = <34 33>;
        };

        home_key {
            bindings = <&kp HOME>;
            key-positions = <31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC       &kp Q         &kp W             &kp E          &kp R           &kp T      &kp Y      &kp U          &kp I          &kp O              &kp P            &kp BSPC
&kp CAPSLOCK  &thml LGUI A  &thml LEFT_ALT S  &thml LCTRL D  &thml LSHIFT F  &kp G      &kp H      &thmr RSHFT J  &thmr RCTRL K  &thmr RIGHT_ALT L  &thmr RGUI SEMI  &kp SQT
&kp DELETE    &kp Z         &kp X             &kp C          &kp V           &kp B      &kp N      &kp M          &kp COMMA      &kp DOT            &kp FSLH         &kp MINUS
                                              &mo 3          &kp SPACE       &lt 2 TAB  &kp ENTER  &gtl1          &gtl4
            >;
        };

        numbers {
            bindings = <
&gtl0    &kp GRAVE         &kp N7                   &kp N8          &kp N9                 &kp FSLH      &kp LS(PIPE)  &kp LS(LBRC)                  &kp LS(RBRC)                   &kp LS(LT)                    &kp LS(GT)                &kp BSPC
&trans   &thml LGUI COLON  &thml LEFT_ALT NUMBER_4  &thml LCTRL N5  &thml LSHIFT NUMBER_6  &kp EQUAL     &kp BSLH      &thmr RSHFT LEFT_PARENTHESIS  &thmr RCTRL RIGHT_PARENTHESIS  &thmr RIGHT_ALT LEFT_BRACKET  &thmr RGUI RIGHT_BRACKET  &trans
&kp DEL  &kp DOT           &kp N1                   &kp N2          &kp N3                 &kp LS(PLUS)  &trans        &kp MINUS                     &kp LS(UNDER)                  &kp HOME                      &kp END                   &trans
                                                    &kp TAB         &kp SPACE              &kp N0        &kp RET       &trans                        &trans
            >;
        };

        cursor {
            bindings = <
&gtl0    &trans    &trans    &trans     &kp LA(LC(HOME))  &trans  &trans    &to 5      &trans     &trans     &trans              &kp BSPC
&trans   &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT         &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp K_CONTEXT_MENU  &trans
&kp DEL  &trans    &trans    &trans     &trans            &trans  &trans    &kp PG_DN  &kp PG_UP  &kp HOME   &kp END             &trans
                             &trans     &trans            &trans  &kp RET   &trans     &trans
            >;
        };

        keyboard {
            bindings = <
&bt BT_CLR                      &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3  &trans  &trans  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_MINIMUM  &kp C_BRIGHTNESS_MAXIMUM  &to 0
&rgb_ug RGB_TOG                 &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &trans        &trans  &trans  &kp C_VOLUME_UP       &kp C_VOLUME_DOWN     &kp K_MUTE                &trans                    &ext_power EP_TOG
&rgb_ug RGB_COLOR_HSB(0,53,43)  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans           &trans        &trans  &trans  &trans                &trans                &trans                    &trans                    &trans
                                                                  &trans           &trans        &trans  &trans  &trans                &trans
            >;
        };

        f_keys {
            bindings = <
&gtl0     &kp F12  &kp F7  &kp F8  &kp F9     &trans   &trans     &trans     &trans     &trans    &trans    &kp BSPC
&kp CAPS  &kp F11  &kp F4  &kp F5  &kp F6     &trans   &trans     &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&kp DEL   &kp F10  &kp F1  &kp F2  &kp F3     &trans   &trans     &trans     &trans     &trans    &trans    &trans
                           &trans  &kp SPACE  &kp TAB  &kp ENTER  &trans     &trans
            >;
        };

        mouse {
            bindings = <
&gtl0   &trans    &trans    &trans     &trans     &trans  &trans            &to 2             &trans           &trans           &trans  &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP     &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans    &trans    &trans     &trans     &trans  &msc MOVE_X(-20)  &msc MOVE_Y(-20)  &msc MOVE_Y(20)  &msc MOVE_X(20)  &trans  &trans
                            &trans     &trans     &trans  &mkp LCLK         &mkp RCLK         &mkp MCLK
            >;
        };
    };
};
